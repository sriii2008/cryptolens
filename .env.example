# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional SQLite database path (defaults to ./data/ecdat.sqlite)
ECDAT_DB_PATH="./data/ecdat.sqlite"

# Optional Enterprise Authentication (leave unset for local Sample Workspace demo mode)
# Set a 16+ char secret to enable server-verified enterprise workspace login & RBAC.
ECDAT_ENTERPRISE_AUTH_SECRET=""
# JSON array of enterprise accounts: [{"email":"admin@corp.example","name":"Alex Rivera","passwordHash":"scrypt:<saltHex>:<hashHex>","workspaces":{"ws-live":"Admin"}}]
ECDAT_ENTERPRISE_USERS_JSON=""

# Optional AWS Connector & Scheduler Settings
# Trusted AWS IAM role/user ARN used by the ECDAT backend when assuming customer roles (STS AssumeRole).
ECDAT_AWS_TRUSTED_PRINCIPAL_ARN=""
# Set a 16+ char secret to arm POST /api/internal/scheduled-sync for Cloud Scheduler or cron.
ECDAT_SCHEDULER_SECRET=""
# Set to "true" to run an in-process 6-hour background sync timer (when running as an always-on instance).
ECDAT_ENABLE_INTERNAL_SCHEDULER="false"

# Standard AWS SDK server-side credentials (if not running on an IAM Workload Identity / ECS / EKS / EC2 role)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""
# AWS_REGION="us-east-1"
